{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hcviz/timeline.schema.json",
  "title": "hcviz per-chunk completion timeline",
  "description": "One benchmarked system's per-chunk completion times. t=0 is generation start (setup/boot excluded). All chunk coords are absolute chunk coords; the emitted race region defaults to cx,cz in [0,31] (r.0.0).",
  "type": "object",
  "required": ["system", "display_name", "wall_s", "chunks"],
  "additionalProperties": false,
  "properties": {
    "system": {
      "type": "string",
      "minLength": 1,
      "description": "Machine-readable system id, e.g. 'vanilla-26.2', 'c2me-26.2', 'hyperchunk-free'"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Panel label as rendered, e.g. 'Vanilla', 'C2ME', 'hyperchunk'"
    },
    "stage": {
      "type": "string",
      "description": "Free-form measurement stage tag, e.g. 'hc-e6/zen5' or 'claw/5900x'"
    },
    "wall_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Generation wall time in seconds; the panel timer freezes at this value"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cx", "cz", "t_done_ms"],
        "additionalProperties": false,
        "properties": {
          "cx": { "type": "integer" },
          "cz": { "type": "integer" },
          "t_done_ms": { "type": "number", "minimum": 0 }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "seed": { "type": "integer" },
        "workers": { "type": "integer", "minimum": 1 },
        "probe_interval_ms": { "type": "number", "exclusiveMinimum": 0 },
        "synthetic": {
          "type": "boolean",
          "description": "true when chunk times are generated from a pattern, not measured"
        },
        "pattern": {
          "type": "string",
          "description": "Synthetic pattern name (scan|wave|burst) when synthetic"
        },
        "source": { "type": "string", "description": "Raw capture file this was converted from" },
        "event": {
          "type": "string",
          "description": "Which per-chunk event t_done_ms marks (hyperchunk: serialize|deco|chain)"
        },
        "policy": { "type": "string" },
        "threads": { "type": "integer" },
        "canonical": { "type": "string" },
        "pass": { "type": "boolean" },
        "region": {
          "type": "object",
          "required": ["x0", "z0", "w", "h"],
          "additionalProperties": false,
          "properties": {
            "x0": { "type": "integer" },
            "z0": { "type": "integer" },
            "w": { "type": "integer", "minimum": 1 },
            "h": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
