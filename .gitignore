build/
build-asan/
build-*/
*.o
*.so
*.a
compile_commands.json

# golden artifacts — SHA256SUMS, rng/ texts, FORMAT.md and order manifests
# are tracked; raw dumps stay local. 07+ dumps are NOT regenerable as the
# same bundle (features order varies run to run, ADR-007): each bundle is a
# coherent (dumps + order.manifest) pair, and the manifest is the Tier-2
# replay input.
golden/*.mca
# canonical per-chunk payloads extracted from the .mca by
# tools/golden/extract_region_ref.py — local-only, hashes in SHA256SUMS
golden/region-ref/
golden/stages/**
!golden/stages/FORMAT.md
!golden/stages/*/
!golden/stages/*/order.manifest
!golden/stages/*/order.snapshots
!golden/stages/*/postprocess.manifest
!golden/stages/*/stages.log
golden/stages-alt/**
!golden/stages-alt/SHA256SUMS
!golden/stages-alt/*/
!golden/stages-alt/*/order.manifest
!golden/stages-alt/*/order.snapshots
!golden/stages-alt/*/postprocess.manifest
!golden/stages-alt/*/stages.log
golden/features-trace/**
!golden/features-trace/FORMAT.md
!golden/features-trace/SHA256SUMS
!golden/features-trace/*/
!golden/features-trace/*/order.manifest
!golden/features-trace/*/order.snapshots
tools/golden/libs/
tools/golden/*.class
tools/golden/work/
tools/golden/stage-dump-mod/build/
tools/golden/stage-dump-mod/.gradle/
tools/golden/stage-dump-mod/run/

__pycache__/
*.pyc
.DS_Store

# vanilla server debris if a jar is ever launched from repo root
logs/
build-release/
